          "request": {
            "name": "Get MVCC info by hex key",
            "description": {
              "content": "Returns MVCC information for a key specified as a hexadecimal string. This endpoint is used when you have the raw encoded key from TiKV region information and need to look up the MVCC history for that specific key.",
