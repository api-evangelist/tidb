          "id": "58fe8f49-7eec-4ceb-befb-e4a9b6ab839d",
          "name": "Get MVCC info by row handle",
          "request": {
            "name": "Get MVCC info by row handle",
            "description": {
              "content": "Returns multi-version concurrency control (MVCC) information for the key corresponding to the specified row handle in a table. Shows all versions of the key across transactions, including start timestamp, commit timestamp, and value. Used for debugging transaction conflicts and stale data issues.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "mvcc",
                "key",
                ":db",
                ":table",
                ":handle"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "db",
                  "description": "(Required) The database name."
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "table",
                  "description": "(Required) The table name within the specified database."
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "handle",
                  "description": "(Required) The row handle (primary key value or internal row ID) for the target row."
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
