          "name": "List audit logs",
          "request": {
            "name": "List audit logs",
            "description": {
              "content": "Returns a paginated list of console audit logs for the organization. Audit logs capture administrative actions such as cluster creation, deletion, and configuration changes, along with the user email, timestamp, and result of each action. Supports filtering by time range, event type, and keyword.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "auditLogs"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "pageSize",
                  "value": "100",
                  "description": "Maximum number of results to return per page. Default is 100, maximum is 100."
                },
                {
                  "disabled": false,
                  "key": "pageToken",
                  "value": "<string>",
                  "description": "Pagination token returned from a previous list request to retrieve the next page."
                },
                {
                  "disabled": false,
                  "key": "startTime",
                  "value": "<dateTime>",
                  "description": "Filter audit logs starting from this ISO 8601 datetime."
                },
                {
                  "disabled": false,
                  "key": "endTime",
                  "value": "<dateTime>",
                  "description": "Filter audit logs up to this ISO 8601 datetime."
                },
                {
                  "disabled": false,
                  "key": "auditEventTypes",
                  "value": "<string>",
                  "description": "Comma-separated list of event types to filter by."
                },
                {
                  "disabled": false,
                  "key": "keyword",
                  "value": "<string>",
                  "description": "Search term to filter audit log entries."
                }
              ],
              "variable": []
            },
