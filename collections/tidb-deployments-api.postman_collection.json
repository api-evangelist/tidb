        {
          "id": "f6df5be4-101a-4196-b77c-a1388fa4c64d",
          "name": "Create a deployment",
          "request": {
            "name": "Create a deployment",
            "description": {
              "content": "Deploys the current configuration of a Data App, making all defined endpoints live. Creates an immutable deployment record that can be referenced for rollback. Endpoints are not publicly accessible until a successful deployment is created.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "dataApps",
                ":dataAppId",
                "deployments"
              ],
              "host": [
