          "name": "Get server settings",
          "request": {
            "name": "Get server settings",
            "description": {
              "content": "Returns the current runtime settings of the TiDB server instance, including log level, general log status, and DDL slow threshold. These settings can be modified without restarting the server via the POST method of this endpoint.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "settings"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
