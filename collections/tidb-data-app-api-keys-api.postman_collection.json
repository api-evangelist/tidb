          "name": "Create a Data App API key",
          "request": {
            "name": "Create a Data App API key",
            "description": {
              "content": "Creates a new API key scoped to a specific Data App. Specify the key description, role (READ_ONLY or READ_AND_WRITE), rate limit in requests per minute, and optional expiration settings. The private key is only returned at creation time.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "dataApps",
                ":dataAppId",
                "apiKeys"
              ],
              "host": [
                "{{baseUrl}}"
