          "request": {
            "name": "List Data App API keys",
            "description": {
              "content": "Returns all API keys scoped to a specific Data App. These keys are used to authenticate calls to the custom endpoints defined within the Data App and are separate from organization-level API keys.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "dataApps",
                ":dataAppId",
                "apiKeys"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "pageSize",
                  "value": "100",
                  "description": "Maximum number of results to return per page. Default is 100, maximum is 100."
                },
                {
                  "disabled": false,
                  "key": "pageToken",
                  "value": "<string>",
                  "description": "Pagination token returned from a previous list request to retrieve the next page."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "dataAppId",
                  "description": "(Required) The unique identifier of the Data App."
                }
