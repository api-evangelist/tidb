      "name": "Statistics",
      "description": {
        "content": "Endpoints for exporting optimizer statistics used for query planning.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "8f092649-bbf9-4f21-8675-01bb49b64111",
          "name": "Dump table statistics",
          "request": {
            "name": "Dump table statistics",
            "description": {
              "content": "Returns the optimizer statistics for the specified table in JSON format. Statistics include histogram data, count-min sketch approximations, and correlation coefficients used by the TiDB query optimizer when generating execution plans. Optionally specify a timestamp to retrieve historical statistics.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "stats",
                "dump",
                ":db",
                ":table"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "timestamp",
                  "value": "<integer>",
                  "description": "Optional Unix timestamp to retrieve historical statistics at a specific point in time."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "db",
                  "description": "(Required) The database name."
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "table",
                  "description": "(Required) The table name within the specified database."
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
            {
