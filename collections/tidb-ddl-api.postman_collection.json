        {
          "id": "0c9284b9-41db-4686-b9a9-f852d49af601",
          "name": "Resign DDL owner",
          "request": {
            "name": "Resign DDL owner",
            "description": {
              "content": "Forces the current TiDB server to resign its role as the DDL owner, triggering a new DDL owner election among all TiDB servers in the cluster. Only one TiDB server is the DDL owner at any time and is responsible for executing schema change jobs. Use this endpoint when the current DDL owner is experiencing issues.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "ddl",
                "owner",
                "resign"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "method": "POST",
            "auth": null
          },
          "response": [
            {
              "id": "c88edd78-2e5b-4638-b5b0-723fa4163bb4",
              "name": "DDL owner resignation initiated successfully.",
              "originalRequest": {
                "url": {
                  "path": [
