          "name": "Create a data summary",
          "request": {
            "name": "Create a data summary",
            "description": {
              "content": "Generates an AI-powered summary of the specified database schema on a linked TiDB Cloud cluster. The summary analyzes table structures, relationships, and data distributions to provide context for subsequent SQL generation. Set reuse to true to return an existing summary if one already exists for this database.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v3",
                "dataSummaries"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cluster_id\": \"<string>\",\n  \"database\": \"<string>\",\n  \"description\": \"<string>\",\n  \"reuse\": \"<boolean>\"\n}",
